# Domino middleware site settings (separate from Rynan middleware)
#
# Rynan example (do not reuse):
#   PORT=5001
#   PUBLIC_HOSTNAME=r10-print.k95foods.com
#
# Domino (this app):
HOST=0.0.0.0
PORT=5003
TUNNEL_NAME=domino-print
PUBLIC_HOSTNAME=domino-print.k95foods.com

# Optional API key — if set, ERP must send header X-API-Key
# API_KEY=

# Printer TCP
PRINTER_CONNECT_TIMEOUT=5
PRINTER_READ_TIMEOUT=5
PRINTER_SEND_RETRIES=3

# Set true if Domino is configured for fixed-length ACK (06303030)
# DOMINO_FIXED_ACK_MODE=false
